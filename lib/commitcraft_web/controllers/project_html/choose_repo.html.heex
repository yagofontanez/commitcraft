<.flashes flash={@flash} />
<.site_header current_user={@current_user} width="full" />

<main class="px-6 py-16 md:px-10 md:py-20">
  <.link navigate={~p"/jogar/#{@project.slug}"} class="text-sm text-muted hover:text-bone">
    &larr; {@project.name}
  </.link>

  <h1 class="mt-6 text-3xl font-semibold tracking-tight text-bone md:text-4xl">
    Escolha o repositório
  </h1>

  <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted">
    Só aparecem repositórios seus — conectar exige criar um webhook, e isso
    depende de você administrar o repositório. Estão ordenados pelo último envio.
  </p>

  <div :if={@repos == []} class="frame mt-10 px-8 py-16 text-center">
    <p class="font-pixel text-[13px] text-muted">Nenhum repositório</p>
    <p class="mx-auto mt-5 max-w-sm text-sm leading-relaxed text-muted">
      O GitHub não devolveu nenhum repositório seu. Crie um por lá e volte.
    </p>
  </div>

  <ul :if={@repos != []} class="mt-10 grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
    <li :for={repo <- @repos}>
      <% ocupado = @conectados[repo.id] %>
      <div class={["frame h-full px-6 py-5", ocupado && "opacity-60"]}>
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="min-w-0 truncate font-semibold text-bone">{repo.name}</h2>
          <span :if={repo.private} class="shrink-0 font-pixel text-[9px] text-muted">
            privado
          </span>
        </div>

        <p class="mt-2 truncate text-xs text-muted">{repo.full_name}</p>

        <p :if={repo.description} class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">
          {repo.description}
        </p>

        <p :if={ocupado} class="mt-4 text-xs text-muted">
          já está em <span class="text-bone">{ocupado.name}</span>
        </p>

        <.form
          :if={is_nil(ocupado)}
          for={%{}}
          action={~p"/jogar/#{@project.slug}/repositorio"}
          class="mt-5"
        >
          <input type="hidden" name="repo_id" value={repo.id} />
          <button type="submit" class="btn-craft w-full justify-center !py-3 text-[11px]">
            Conectar
          </button>
        </.form>
      </div>
    </li>
  </ul>
</main>

<.site_footer width="full" />
