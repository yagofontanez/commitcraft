<.flashes flash={@flash} />
<.site_header current_user={@current_user} width="full" />

<%!-- O nível subir é o momento que o jogo inteiro existe para produzir. Ele
      aparece por cima de tudo e sai sozinho. --%>
<div
  :if={@level_up}
  id="level-up"
  phx-mounted={JS.transition({"level-up-entrada", "opacity-0", "opacity-100"}, time: 700)}
  class="pointer-events-none fixed inset-x-0 top-24 z-40 flex justify-center px-4"
>
  <div class="frame-gold px-10 py-6 text-center">
    <p class="font-pixel text-lg text-gold pixel-shadow">LEVEL UP</p>
    <p class="mt-3 font-pixel text-sm text-bone">nível {padded(@level_up)}</p>
  </div>
</div>

<main class="px-6 py-16 md:px-10 md:py-20">
  <.link navigate={~p"/jogar"} class="text-sm text-muted hover:text-bone">
    &larr; Seus projetos
  </.link>

  <%!-- Nome escrito pela pessoa vai na fonte de leitura, não na pixelada: o
        Silkscreen mastiga cedilha e til, e "Ração" fica ilegível. A fonte de
        pixel fica para o chrome do jogo, que é texto nosso e sem acento.

        Renomear abre no próprio título, onde a pessoa está olhando. --%>
  <details class="group mt-6" open={@form.errors != []}>
    <summary class="inline-flex cursor-pointer list-none flex-wrap items-baseline gap-x-4 gap-y-1 [&::-webkit-details-marker]:hidden">
      <h1 class="text-3xl font-semibold tracking-tight text-bone md:text-4xl">
        {@project.name}
      </h1>
      <span class="text-sm text-muted transition-colors group-hover:text-gold">renomear</span>
    </summary>

    <.form
      for={@form}
      phx-submit="rename"
      class="mt-6 flex max-w-xl flex-col gap-3 sm:flex-row"
    >
      <div class="min-w-0 flex-1">
        <input
          type="text"
          name={@form[:name].name}
          value={Phoenix.HTML.Form.normalize_value("text", @form[:name].value || @project.name)}
          required
          maxlength="60"
          aria-label="Novo nome do projeto"
          class="w-full border-0 bg-ink px-4 py-3.5 text-bone focus:outline-none"
        />
        <p :for={{mensagem, _} <- @form[:name].errors} class="mt-2 text-xs text-ember">
          O nome {mensagem}.
        </p>
      </div>
      <button type="submit" class="btn-craft justify-center">Salvar</button>
    </.form>
  </details>

  <%!-- A classe é observada, não escolhida: o projeto ganha o apelido pelo jeito
        como foi construído. --%>
  <p :if={@class} class="mt-6 flex flex-wrap items-baseline gap-x-3 text-sm">
    <span class="font-pixel text-[11px] text-violet">{@class.name}</span>
    <span class="text-muted">{@class.how}</span>
  </p>

  <%!-- O aviso vem antes do painel porque é a única coisa nesta tela que tem
        prazo. --%>
  <div
    :if={@streak_status.at_risk}
    class="frame-gold mt-8 flex max-w-xl flex-wrap items-center gap-x-4 gap-y-2 px-6 py-4"
  >
    <span class="font-pixel text-[11px] text-gold">&#9888; SEQUÊNCIA EM RISCO</span>
    <span class="text-sm text-bone">
      Seus {@streak_status.days} dias morrem à meia-noite. {if @streak_status.hours_left == 1,
        do: "Falta uma hora.",
        else: "Faltam #{@streak_status.hours_left} horas."}
    </span>
  </div>

  <div class="mt-10 max-w-md">
    <.hud progress={@progress}>
      <:caption>
        projeto <span class="text-bone">{@project.slug}</span>
        <span :if={@streak_status.days > 0} class="text-moss">
          · {@streak_status.days}
          {if @streak_status.days == 1, do: "dia", else: "dias"} de sequência
        </span>
      </:caption>
    </.hud>
  </div>

  <div class="hairline my-12"></div>

  <%!-- Sem repositório, a tela diz isso em vez de fingir uma linha do tempo
        vazia que parece defeito. --%>
  <div
    :if={is_nil(@project.repo_full_name)}
    class="frame flex flex-col items-center gap-5 px-8 py-20 text-center"
  >
    <.sprite name={:commits} class="h-12 w-12" recolor={%{"n" => "#6b5c99", "l" => "#4a3f75"}} />
    <p class="font-pixel text-[13px] leading-relaxed text-muted">Nada aconteceu ainda</p>
    <p class="max-w-md text-sm leading-relaxed text-muted">
      Este projeto está no nível {@progress.level} com {numero(@progress.xp)} de XP,
      porque ainda não há repositório conectado. Conecte um e cada commit, pull
      request e deploy passa a cair aqui.
    </p>
    <.link navigate={~p"/jogar/#{@project.slug}/repositorio"} class="btn-craft mt-2">
      Conectar repositório
    </.link>
  </div>

  <div :if={@project.repo_full_name} class="frame px-7 py-6">
    <div class="flex flex-wrap items-center justify-between gap-5">
      <div class="flex min-w-0 items-center gap-4">
        <.sprite name={:commits} class="h-10 w-10 shrink-0" />
        <div class="min-w-0">
          <p class="truncate font-semibold text-bone">{@project.repo_full_name}</p>
          <p class="mt-1 text-xs text-muted">
            <span :if={@project.repo_private}>privado · </span>
            <span :if={@listening?} class="text-moss">escutando</span>
            <span :if={!@listening?} class="text-ember">webhook não instalado</span>
          </p>
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-5">
        <.link
          navigate={~p"/jogar/#{@project.slug}/repositorio"}
          class="text-sm text-muted hover:text-bone"
        >
          trocar
        </.link>
        <button
          type="button"
          phx-click="disconnect_repo"
          class="text-sm text-muted hover:text-ember"
        >
          desconectar
        </button>
      </div>
    </div>

    <div :if={!@listening?} class="mt-6 border-t-[3px] border-stone/50 pt-6">
      <p class="text-sm leading-relaxed text-muted">
        O repositório está ligado, mas o GitHub ainda não tem para onde entregar
        os eventos — em desenvolvimento isso quer dizer que falta um túnel
        apontando para este servidor.
      </p>

      <.form for={%{}} action={~p"/jogar/#{@project.slug}/webhook"} class="mt-5">
        <button type="submit" class="btn-ghost-craft">Instalar webhook</button>
      </.form>
    </div>
  </div>

  <%!-- Vercel e Stripe não pedem token de API: quem cria o webhook é você, no
        painel delas, e o CommitCraft só recebe a entrega e confere a
        assinatura. Menos permissão nossa na sua conta. --%>
  <div :if={@project.repo_full_name} class="mt-16">
    <h2 class="font-pixel text-sm text-gold">Outras fontes de XP</h2>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <.integration
        source="vercel"
        nome="Vercel"
        sprite={:triangle}
        descricao="Cada deploy em produção vale XP; build quebrado custa."
        onde="Vercel → Settings → Webhooks → Create Webhook, marcando os eventos de deployment."
        webhook={@webhooks["vercel"]}
      />

      <.integration
        source="stripe"
        nome="Stripe"
        sprite={:card}
        descricao="A primeira venda vale muito; as seguintes viram rotina."
        onde="Stripe → Developers → Webhooks → Add endpoint, com os eventos de pagamento."
        webhook={@webhooks["stripe"]}
      />
    </div>
  </div>

  <div :if={@achievements != []} class="mt-16">
    <h2 class="font-pixel text-sm text-gold">Conquistas</h2>

    <ul class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      <li
        :for={conquista <- @achievements}
        id={"achievement-#{conquista.id}"}
        phx-mounted={
          novidade?(@recem_chegados, :achievement, conquista.id) &&
            JS.transition({"medalha-entrada", "opacity-0", "opacity-100"}, time: 700)
        }
        class="frame px-6 py-6"
      >
        <% catalogo = CommitCraft.Game.Achievements.get(conquista.key) %>
        <.sprite name={:coin} class="h-9 w-9" recolor={rarity_paint(catalogo.rarity)} />
        <h3 class="mt-5 font-pixel text-[13px] leading-snug text-bone">{catalogo.name}</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">{catalogo.how}</p>
        <p class={["mt-4 font-pixel text-[10px]", rarity_text(catalogo.rarity)]}>
          {catalogo.rarity} · {Calendar.strftime(conquista.unlocked_at, "%d/%m/%Y")}
        </p>
      </li>
    </ul>
  </div>

  <div :if={@events != []} class="mt-16">
    <h2 class="font-pixel text-sm text-gold">O ano</h2>

    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      Cada quadradinho é um dia. Quanto mais claro, mais aconteceu.
    </p>

    <.heatmap weeks={@heatmap} class="mt-8" />
  </div>

  <div class="mt-16">
    <h2 class="font-pixel text-sm text-gold">O caminho</h2>

    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      Cada bloco é uma coisa que aconteceu. O mais antigo à esquerda, o mais
      recente à direita — e é sobre ele que você está de pé.
    </p>

    <div class="mt-8">
      <.journey events={@events} listening={@listening?} recem_chegados={@recem_chegados} />
    </div>

    <%!-- A lista continua embaixo: o mapa é bom para sentir o percurso, a lista
          é melhor para ler muita coisa de uma vez. --%>
    <details :if={@events != []} class="group mt-8">
      <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm text-muted transition-colors hover:text-bone [&::-webkit-details-marker]:hidden">
        <span class="font-pixel text-[10px] text-muted group-open:text-gold">&#9660;</span>
        Ver como lista
      </summary>

      <ul class="mt-6 space-y-px">
        <li
          :for={event <- @events}
          class="flex flex-wrap items-baseline gap-x-5 gap-y-1 bg-panel/60 px-6 py-4"
        >
          <span class={["shrink-0 font-pixel text-[11px]", event_tone(event.xp)]}>
            {if event.xp > 0, do: "+#{event.xp}", else: event.xp}
          </span>
          <span class="min-w-0 flex-1 truncate text-sm text-bone">{event.title}</span>
          <span class="shrink-0 text-xs text-muted">{event_label(event.kind)}</span>
          <span class="shrink-0 font-pixel text-[10px] text-muted">
            {Calendar.strftime(event.occurred_at, "%d/%m %H:%M")}
          </span>
        </li>
      </ul>
    </details>
  </div>

  <%!-- Publicar é um ato deliberado, então a tela diz exatamente o que passa a
        ser visível — inclusive o que NÃO passa. --%>
  <div class="mt-16 max-w-2xl">
    <h2 class="font-pixel text-sm text-gold">Página pública</h2>

    <div class="frame mt-6 px-6 py-6">
      <p :if={!@project.public} class="text-sm leading-relaxed text-muted">
        Este projeto é privado. Abrindo a página pública, qualquer pessoa com o
        link vê o nome, o nível, a classe, as conquistas e o caminho.
        <span :if={!@reveal_titles} class="text-bone">
          O texto dos commits fica de fora, porque o repositório é privado.
        </span>
        <span :if={@reveal_titles} class="text-bone">
          As mensagens de commit aparecem — o repositório é público, então elas
          já são.
        </span>
      </p>

      <div :if={@project.public}>
        <p class="text-sm leading-relaxed text-muted">
          Está no ar. Qualquer pessoa com este link vê o projeto:
        </p>

        <code class="mt-4 block truncate bg-ink px-4 py-3 text-xs text-bone">
          {url(~p"/p/#{@current_user.github_login}/#{@project.slug}")}
        </code>

        <%!-- O selo é o que leva o CommitCraft para onde outras pessoas já
              estão olhando: o README de quem usa. --%>
        <p class="mt-6 text-sm leading-relaxed text-muted">
          E este é o selo para colar no README do repositório:
        </p>

        <code class="mt-3 block overflow-x-auto bg-ink px-4 py-3 text-xs whitespace-pre text-bone">{markdown_do_selo(
          @current_user.github_login,
          @project.slug
        )}</code>

        <img
          src={~p"/p/#{@current_user.github_login}/#{@project.slug}/badge.svg"}
          alt="Prévia do selo"
          class="mt-4 h-5"
        />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-5">
        <button type="button" phx-click="toggle_public" class="btn-ghost-craft">
          {if @project.public, do: "Fechar a página", else: "Tornar público"}
        </button>

        <.link
          :if={@project.public}
          navigate={~p"/p/#{@current_user.github_login}/#{@project.slug}"}
          class="text-sm text-muted hover:text-bone"
        >
          ver como fica
        </.link>
      </div>
    </div>
  </div>

  <%!-- Apagar fica atrás de um <details>: um clique abre, outro confirma. O
        texto diz em números o que está sendo jogado fora. --%>
  <details class="group mt-16 max-w-xl">
    <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm text-muted transition-colors hover:text-ember [&::-webkit-details-marker]:hidden">
      <span class="font-pixel text-[10px] text-muted group-open:text-ember">&#9660;</span>
      Apagar este projeto
    </summary>

    <div class="frame mt-5 px-6 py-6">
      <p class="text-sm leading-relaxed text-bone">
        Isso apaga <span class="font-semibold">{@project.name}</span>, o nível {@progress.level} e os {numero(
          @progress.xp
        )} de XP acumulados.
        Não dá para desfazer.
      </p>

      <button type="button" phx-click="delete" class="btn-ghost-craft mt-6 !text-ember">
        Apagar mesmo
      </button>
    </div>
  </details>
</main>

<.site_footer width="full" />
